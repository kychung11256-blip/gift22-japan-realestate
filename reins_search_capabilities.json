      "line2_3": {"reins_label": "沿線２/沿線３", "type": "同沿線１", "selectors": ["#__BVID__417 起", "#__BVID__437 起"]},
      "bus_route": {"reins_label": "バス路線名", "type": "text", "selector": "#__BVID__457", "match": "完全一致"},
