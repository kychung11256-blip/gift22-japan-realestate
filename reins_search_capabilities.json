      "bus_walk": {"reins_label": "バス停から徒歩", "type": "text+select", "selectors": ["#__BVID__463", "#__BVID__465"], "unit": "分 or ｍ"},
      "other_transport": {"reins_label": "交通手段名", "type": "text", "selector": "#__BVID__468", "match": "部分一致"}
