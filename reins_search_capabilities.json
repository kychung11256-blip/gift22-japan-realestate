{
  "source": "reins",
  "search_page": "売買物件検索 (GBK001210)",
  "_note": "純 capability 記錄，未接 production。selector 係 REINS Vue BVID（動態但穩定）。category: hard_filter=REINS 表單直接搜尋 / post_filter=search result 有資料可二次過濾 / semantic_preference=REINS 無結構化 filter。",

  "target_division": {
    "johnny_key": "target",
    "reins_label": "対象区分",
    "type": "radio",
    "values": ["在庫", "成約"],
    "selectors": ["#__BVID__284", "#__BVID__285"],
    "category": "hard_filter",
    "note": "在庫=現售；成約=已成交（做 market data 用）"
  },
  "sort": {
    "johnny_key": "sort",
    "reins_label": "並び順",
    "type": "select+select(升降)",
